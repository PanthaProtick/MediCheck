# ==============================================================================
# RxVerify v2 Multi-User Environment Configuration Example
# ==============================================================================

# Project Mode & Core Settings
PROJECT_NAME="RxVerify Availability Verification MVP v2"
ENV="production"  # "development" | "demo" | "production"
DEBUG=False
STATIC_DIR=""     # Path to frontend/dist (auto-detected if blank)

# SQLite Fallback / MVP Settings
DEMO_DATABASE_PATH="/app/backend/data/demo.sqlite3"
DEMO_STAFF_TOKEN="server-internal-baseline-token"

# PostgreSQL (Neon) Database Configuration
# Format: postgresql+psycopg://<user>:<password>@<ep-id>.<region>.neon.tech/<dbname>?sslmode=require
DATABASE_URL="postgresql+psycopg://neondb_owner:password@ep-demo-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"
TEST_DATABASE_URL=""
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=2.0

# Managed Authentication (Clerk) Settings
# Obtain from Clerk Dashboard > API Keys & JWT Templates
CLERK_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="REPLACE_WITH_PROVIDER_SECRET"
CLERK_ISSUER="https://your-instance.clerk.accounts.dev"

# Public Production Origins & Security
PUBLIC_APP_ORIGIN="https://rxverify.onrender.com"
CORS_ORIGINS=["https://rxverify.onrender.com", "http://localhost:5173", "http://localhost:8000"]

# Rate Limiting & Denial-of-Service Boundaries (P08 Policy)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_MAX_MUTATIONS=30
MAX_REQUEST_BODY_BYTES=16384
