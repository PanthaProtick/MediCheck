# Set these in your hosting provider's environment/secrets panel.
# This file contains placeholders only. Do not commit a filled-in copy.
APP_MODE=hosted
ENV=production
DEBUG=false
DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/DBNAME?sslmode=require
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_ISSUER=https://clerk.YOUR_DOMAIN
PUBLIC_APP_ORIGIN=https://app.YOUR_DOMAIN
CORS_ORIGINS=["https://app.YOUR_DOMAIN"]
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=2
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_MAX_MUTATIONS=30
MAX_REQUEST_BODY_BYTES=16384
# Used for separate integration testing only. Do not point at your deployed database.
TEST_DATABASE_URL=
# Docker sets STATIC_DIR automatically; no DEMO_STAFF_TOKEN or CLERK_SECRET_KEY is needed.
